App(
    appid="desktop_settings",
    name="Desktop",
    apptype=FlipperAppType.SETTINGS,
    entry_point="desktop_settings_app",
    requires=[
        "desktop",
        "gui",
    ],
    flags=["InsomniaSafe"],
    stack_size=1 * 1024,
    order=50,
    # These wrappers are used by the standalone port, but the built-in settings
    # app already links their implementations from the Desktop service.
    sources=["*.c*", "!helpers/pin_code.c", "!views/desktop_view_pin_input.c"],
    fap_category="assets",
)
