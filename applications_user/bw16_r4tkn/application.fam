App(
    appid="bw16_r4tkn",
    name="[BW16] R4TKN WiFi",
    fap_version=(1, 0),
    apptype=FlipperAppType.EXTERNAL,
    entry_point="bw16_r4tkn_app",
    requires=["gui", "dialogs"],
    stack_size=4 * 1024,
    order=90,
    fap_icon="icon.png",
    fap_category="GPIO",
    fap_author="rusyln (R4TKN); ESP32-S3 port",
    fap_description="Companion for the RTL8720DN BW16 WiFi module (R4TKN firmware): "
