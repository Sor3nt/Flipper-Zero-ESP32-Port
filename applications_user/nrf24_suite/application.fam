# nRF24 Suite - ported from OuinOuin74/nrf24tool and re-bound to the
# LilyGO T-Embed ESP32 hardware (CE=GPIO43, CS=gpio_nrf24_cs owned by the HW
# SPI driver, bus=furi_hal_spi_bus_handle_nrf24).
# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="nrf24_suite",  # Must be unique
    name="NRF24 Suite",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nrf24_suite_app",
    stack_size=4 * 1024,
    fap_category="GPIO",
    # Optional values
    fap_version="1.2",
    fap_icon="nrf24tool.png",  # 10x10 1-bit PNG
    fap_description="Utility app for NRF24L01 (RX/TX/Sniffer/BadMouse)",
    fap_author="S. Terrier (ESP32 port)",
    fap_weburl="https://github.com/OuinOuin74/nrf24tool",
    fap_icon_assets="images",  # Image assets to compile for this application
    # NOTE: fap_private_libs is intentionally NOT used here. The vendored driver
    # lives at libnrf24/ (not lib/<name>/), and buildFap.sh's default whole-app
    # glob already compiles libnrf24/nrf24.c. Declaring a private lib would make
    # tools/fap_lib_info.py emit `lib/nrf24/nrf24.c`, a path that does not exist,
    # which would be passed to the compiler as a missing source file.
)
