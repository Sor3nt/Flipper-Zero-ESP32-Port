App(
    appid="signal_generator",
    name="Signal Generator",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="signal_gen_app",
    requires=["gui"],
    stack_size=1 * 1024,
    fap_description="Control GPIO pins to generate digital signals (PWM and clock on the external header pins)",
