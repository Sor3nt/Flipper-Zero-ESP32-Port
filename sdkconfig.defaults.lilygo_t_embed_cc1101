# UART0's default GPIO43/44 are the T-Embed shared external/NRF pins.
# Applied only to this board; other S3 board console choices remain unchanged.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Dual-core: the forced-reboot combo (BOOT + KEY, 5 s, fires after release)
# runs from an esp_timer ISR on CPU1, so it still works when CPU0 is stuck.
# esp32s3_generic shares the board header but not this file: it stays
# single-core.
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_TIMER_SHOW_EXPERIMENTAL=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU1=y
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
CONFIG_FURI_HAL_REBOOT_COMBO=y

# OTA / Dual-App partition table for firmware self-update.
# The build scripts generate a board-isolated <build_dir>/sdkconfig from
# sdkconfig.defaults + this file; they do NOT load sdkconfig.defaults.esp32s3
# (which also carries these lines). sdkconfig.defaults itself sets the
# single-app table, so without the override here the T-Embed build would fall
# back to single-app and OTA / self-update would break.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota_16mb.csv"
