# Writes the firmware build timestamp (the build PC's local date and time) for
# Settings > About > Firmware. Run by the custom command in the top-level
# CMakeLists.txt with -DOUT=<file>.
if(NOT OUT)
    message(FATAL_ERROR "furi_build_time.cmake: OUT is not set")
endif()

string(TIMESTAMP _furi_build_time "%Y-%m-%d %H:%M:%S")

file(WRITE "${OUT}"
    "/* Generated by cmake/furi_build_time.cmake. Do not edit. */\n"
    "const char furi_build_time[] = \"${_furi_build_time}\";\n")
