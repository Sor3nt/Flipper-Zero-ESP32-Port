build*/
.cache/
.idea/
__pycache__/
sdkconfig.old
.DS_Store
.vscode/settings.json

# Local-dev tooling (not for upstream)
_flash_helper.py

# Managed components are pulled by IDF component manager from idf_component.yml
# + dependencies.lock; the source-of-truth is those two files.
managed_components/

# Local development snapshots and generated release artifacts
.backups/
*.before-*
*.after-*
*.bak
*.orig
*.rej
*~
releases/*.zip
*-backup-*
*.backup-*
/tmp/

# Generated feature validation output
/tests/wdgwars_map/render_previews/
/build*.log

# Root-level FAM registry, regenerated at every CMake configure into the build
# dir (main/CMakeLists.txt). The checked-in copies carried foreign absolute
# paths and are not used by the build. Root-anchored so build-dir and
# main/generated paths are unaffected.
/generated/

# python interpreter shim for ESP-IDF venv (auto-created by buildAndFlash scripts)
.pyshim/

# Claude Code local state (settings, memory, locks) - not project source
.claude/
